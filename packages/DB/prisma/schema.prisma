generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  password    String
  name        String
  photo       String?
  chats       Chat[]
  rooms       Room[]  @relation("AdminRooms")
  memberRooms RoomMember[] 
  favorite    RoomFavorite[]
}

model Room {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  createdAt   DateTime @default(now())
  adminId     String
  photo       String?
  chats       Chat[]
  admin       User     @relation("AdminRooms", fields: [adminId], references: [id])
  members     RoomMember[] 
  favoritedBy RoomFavorite[]
  @@index([adminId])
}

model Chat {
  id      Int    @id @default(autoincrement())
  roomId  Int
  message String
  userId  String
  room    Room   @relation(fields: [roomId], references: [id])
  user    User   @relation(fields: [userId], references: [id])
  @@index([roomId])
  @@index([userId])
}

model RoomMember {
  userId    String
  roomId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])   // composite PK = automatic index
  @@index([roomId])        // fast lookup by room
  @@index([userId])        // fast lookup by user
}

model RoomFavorite {
  userId    String
  roomId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@index([roomId])
  @@index([userId])
}